# Copy to .env. Never commit .env or instance/.
BASE_URL=http://127.0.0.1:5000
# file saves demonstration emails to instance/outbox/. It does not send emails.
# To send actual email: set smtp and fill your provider's STARTTLS credentials.
MAIL_MODE=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=clinic@example.com
SMTP_TLS=true
# Set true only when serving through HTTPS.
COOKIE_SECURE=false
# Leave empty to auto-generate a persistent local signing key.
SECRET_KEY=
